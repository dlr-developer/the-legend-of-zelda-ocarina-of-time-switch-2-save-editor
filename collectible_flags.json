{
 "_about": "Save-data sources for each guide entry, read from the game's own data (v2.0.0 RomFS: Banc placements + GameDataList) and checked against real saves. An entry counts as collected when ANY of its sources is set.",
 "_sources": {
  "key64": "64-bit placement ID present in the sorted, zero-terminated u64 list in progress.sav whose file offset is the value of field 0xA3DB7114",
  "chest": "member of the IsTreasureBoxOpen struct (member name = decimal placement ID); 'hash' is the ordinary Bool field in the main table",
  "flag": "ordinary named Bool field in the main table; hash = MurmurHash3_32(name)"
 },
